# Copy to /opt/movierater/.env.server, owned by the deployment user, chmod 600.
# Plain KEY=value only; do not quote values. No credentials belong in this file.
HTTP_PORT=8080
MOVIERATER_HTTPS=false
MOVIERATER_DOMAIN=
ACME_EMAIL=
DEPLOY_TIMEOUT=180

# Enable HTTPS after DNS points to the server and ports 80/443 are available:
# MOVIERATER_HTTPS=true
# MOVIERATER_DOMAIN=movies.example.com
# ACME_EMAIL=admin@example.com
# VITE_SUPABASE_* values are embedded by the approved image build, not at startup.
# GHCR credentials belong in the deployment user's Docker credential store.
